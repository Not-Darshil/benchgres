# App storage (runs, steps, recommendations). SQLite keeps the app's own
# queries out of the target's pg_stat_statements.
DATABASE_URL=sqlite:///./benchgres.db

# Target: the database being analyzed. Connect as the read-only role.
TARGET_HOST=localhost
TARGET_PORT=5434
TARGET_USER=benchgres_ro
TARGET_PASSWORD=benchgres_ro

# Throwaway: the copy where fixes are applied and benchmarked.
THROWAWAY_HOST=localhost
THROWAWAY_PORT=5433
THROWAWAY_USER=postgres
THROWAWAY_PASSWORD=postgres

# Applied to every target/throwaway connection so a bad plan can't hang the app.
STATEMENT_TIMEOUT_MS=60000
